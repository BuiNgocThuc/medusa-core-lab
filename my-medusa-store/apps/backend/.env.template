# =====================
# Server Configuration
# =====================
PORT=9001

# =====================
# Secrets (REQUIRED)
# Generate secure random strings for production
# =====================
JWT_SECRET=your-jwt-secret
COOKIE_SECRET=your-cookie-secret

# =====================
# CORS Configuration
# =====================
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:9001
AUTH_CORS=http://localhost:9001,http://localhost:8000

# =====================
# Database
# =====================
DATABASE_URL=postgres://{your_username}:{your-password}@localhost:{port_in_docker}/{your_DB_name}

# =====================
# Redis
# =====================
REDIS_URL=redis://localhost:6379

# =====================
# Bank Transfer Payment
# =====================
BANK_TRANSFER_BANK_NAME=Demo Bank
BANK_TRANSFER_ACCOUNT_NUMBER=0000000000
BANK_TRANSFER_ACCOUNT_NAME=MEDUSA DEMO MERCHANT
BANK_TRANSFER_REFERENCE_PREFIX=PAY
BANK_TRANSFER_EXPIRY_MINUTES=30
# Optional dev/test webhook shared secret. Real bank integrations normally use
# provider-specific signature/checksum rules instead.
BANK_TRANSFER_WEBHOOK_SECRET=

# =====================
# MoMo Payment
# =====================
# For personal demo without MoMo merchant credentials, enable mock mode.
# Mock mode registers pp_momo_default and returns a local fake payUrl without
# calling MoMo's network APIs.
MOMO_MOCK_ENABLED=false
MOMO_ENDPOINT=https://test-payment.momo.vn
MOMO_PARTNER_CODE=<your-momo-partner-code>
MOMO_ACCESS_KEY=<your-momo-access-key>
MOMO_SECRET_KEY=<your-momo-secret-key>
MOMO_PARTNER_NAME=Medusa Store
MOMO_STORE_ID=MedusaStore
MOMO_REDIRECT_URL=https://<your-storefront-domain>/api/payment-return/momo
MOMO_IPN_URL=https://<your-backend-domain>/hooks/payment/momo_default
MOMO_AUTO_CAPTURE=true
MOMO_LANG=vi
MOMO_ORDER_EXPIRE_MINUTES=15

# Local-only mock example:
# MOMO_MOCK_ENABLED=true
# MOMO_REDIRECT_URL=http://localhost:8000/api/payment-return/momo
# MOMO_IPN_URL=http://localhost:9001/hooks/payment/momo_default


# =====================
# Admin / Onboarding
# =====================
MEDUSA_ADMIN_ONBOARDING_TYPE=nextjs
MEDUSA_ADMIN_ONBOARDING_NEXTJS_DIRECTORY=../storefront
MEDUSA_BACKEND_URL=http://localhost:9001
MEDUSA_ADMIN_DISABLED=false

# =====================
# MFA
# =====================
AUTH_MFA_ENCRYPTION_KEY=your-mfa-encryption-key

# =====================
# CloudFlare R2 (File Storage)
# =====================
S3_FILE_URL=your-r2-public-file-url
S3_ACCESS_KEY_ID=your-r2-access-key-id
S3_SECRET_ACCESS_KEY=your-r2-secret-access-key
S3_BUCKET=your-r2-bucket-name
S3_ENDPOINT=your-r2-endpoint
S3_REGION=auto


# =====================
# Logging (optional)
# =====================
LOG_LEVEL=error
# LOG_FILE=
