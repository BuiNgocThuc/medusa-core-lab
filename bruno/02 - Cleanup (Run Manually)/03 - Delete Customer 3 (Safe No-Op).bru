meta {
  name: 03 - Delete Customer 3 (Safe No-Op)
  type: http
  seq: 3
}

delete {
  url: {{baseUrl}}/admin/customers/{{customerId3}}
  body: none
  auth: inherit
}

script:pre-request {
  if (req.getExecutionMode() === "runner") {
    bru.runner.skipRequest();
  }
}

tests {
  test("200 OK", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("deleted is true", function () {
    expect(res.getBody().deleted).to.equal(true);
  });
  test("id matches customerId3", function () {
    const expectedId = bru.getVar('customerId3') || bru.getEnvVar('customerId3');
    expect(res.getBody().id).to.equal(expectedId);
  });
}

docs {
  # 03 - Delete Customer 3 (Safe No-Op)

  Xoa ban ghi khach hang an toan khong co additional_data (tao tu request 06 trong Test Suite) qua endpoint DELETE /admin/customers/:id.

  ## Co che bao ve:
  - Pre-request script kiem tra che do thuc thi: neu chay trong Runner (req.getExecutionMode() === "runner"), Bruno se tu dong bo qua (bru.runner.skipRequest()).
  - Chi thuc thi khi bam nut Send thu cong.

  ## Kiem chung:
  - HTTP Status: 200 OK
  - Body: deleted: true
  - Body id khop voi customerId3
}
