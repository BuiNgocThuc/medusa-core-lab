meta {
  name: 11 - Reject Accept With Tampered Token
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/store/orders/{{transferOrderId}}/transfer/accept
  body: json
  auth: bearer
}

auth:bearer {
  token: {{customerToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "token": "00000000-0000-0000-0000-000000000000"
  }
}

tests {
  test("400/404 Rejected on Tampered Token", function () {
    expect([400, 404]).to.include(res.getStatus());
  });
}

docs {
  # 11 - Reject Accept With Tampered Token

  Kiem thu an ninh phong thu: Ke tan cong co tinh doan hoac gui token gia mao (Tampered UUID).
  He thong phai tu choi giao dich va giu nguyen trang thai `order_change` o trang thai `requested`, khong bi anh huong.
}
