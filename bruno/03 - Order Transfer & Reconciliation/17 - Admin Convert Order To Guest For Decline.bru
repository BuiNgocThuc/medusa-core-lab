meta {
  name: 17 - Admin Convert Order To Guest For Decline
  type: http
  seq: 17
}

post {
  url: {{baseUrl}}/admin/orders/{{declineOrderId}}/transfer/guest
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{declineOrderEmail}}"
  }
}

tests {
  test("200 OK", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("converted order to guest customer", function () {
    const order = res.getBody().order;
    expect(order).to.be.an('object');
    expect(order.id).to.equal(bru.getVar('declineOrderId'));
  });
}

docs {
  # 17 - Admin Convert Order To Guest For Decline

  Chuyen doi don hang `{{declineOrderId}}` ve quyen so huu cua Guest voi email `{{declineOrderEmail}}`.
}
