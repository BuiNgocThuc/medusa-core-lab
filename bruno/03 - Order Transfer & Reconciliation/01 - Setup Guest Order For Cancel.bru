meta {
  name: 01 - Setup Guest Order For Cancel
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/admin/orders?limit=5
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

script:post-response {
  const body = res.getBody();
  if (body && body.orders && body.orders.length > 0) {
    const order = body.orders[3] || body.orders[0];
    const email = `guest_cancel_${Date.now()}@example.test`;
    bru.setVar('cancelOrderId', order.id);
    bru.setEnvVar('cancelOrderId', order.id);
    bru.setVar('cancelOrderEmail', email);
    bru.setEnvVar('cancelOrderEmail', email);
  }
}

tests {
  test("200 OK", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("found orders in system", function () {
    expect(res.getBody().orders).to.be.an('array');
    expect(res.getBody().orders.length).to.be.greaterThan(0);
  });
}

docs {
  # 01 - Setup Guest Order For Cancel

  Lay mot don hang co san tu he thong de chuan bi cho Chu trinh Huy (Cancellation Flow).
  Script se luu ID don hang vao bien `{{cancelOrderId}}` va tao email guest gia lap `{{cancelOrderEmail}}`.
}
